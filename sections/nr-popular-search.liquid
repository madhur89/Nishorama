<link rel="stylesheet" href="{{ 'nr-footer.css' | asset_url }}">
<div class="popular-search-container">
  <div class="popular-search-main">
    {%- for block in section.blocks -%}
      <div class="cust-popular-searches" {{ block.shopify_attributes }}>
        <h4>{{ block.settings.heading }}</h4>
        <ul>
          {%- if block.settings.l1 != blank -%}<li><a href="{{ block.settings.u1 }}">{{ block.settings.l1 }}</a></li>{%- endif -%}
          {%- if block.settings.l2 != blank -%}<li><a href="{{ block.settings.u2 }}">{{ block.settings.l2 }}</a></li>{%- endif -%}
          {%- if block.settings.l3 != blank -%}<li><a href="{{ block.settings.u3 }}">{{ block.settings.l3 }}</a></li>{%- endif -%}
          {%- if block.settings.l4 != blank -%}<li><a href="{{ block.settings.u4 }}">{{ block.settings.l4 }}</a></li>{%- endif -%}
          {%- if block.settings.l5 != blank -%}<li><a href="{{ block.settings.u5 }}">{{ block.settings.l5 }}</a></li>{%- endif -%}
          {%- if block.settings.l6 != blank -%}<li><a href="{{ block.settings.u6 }}">{{ block.settings.l6 }}</a></li>{%- endif -%}
          {%- if block.settings.l7 != blank -%}<li><a href="{{ block.settings.u7 }}">{{ block.settings.l7 }}</a></li>{%- endif -%}
          {%- if block.settings.l8 != blank -%}<li><a href="{{ block.settings.u8 }}">{{ block.settings.l8 }}</a></li>{%- endif -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "NR Popular search",
  "enabled_on": { "groups": ["footer"] },
  "blocks": [
    {
      "type": "group",
      "name": "Link group",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Kurtis" },
        { "type": "text", "id": "l1", "label": "Link 1" }, { "type": "url", "id": "u1", "label": "URL 1" },
        { "type": "text", "id": "l2", "label": "Link 2" }, { "type": "url", "id": "u2", "label": "URL 2" },
        { "type": "text", "id": "l3", "label": "Link 3" }, { "type": "url", "id": "u3", "label": "URL 3" },
        { "type": "text", "id": "l4", "label": "Link 4" }, { "type": "url", "id": "u4", "label": "URL 4" },
        { "type": "text", "id": "l5", "label": "Link 5" }, { "type": "url", "id": "u5", "label": "URL 5" },
        { "type": "text", "id": "l6", "label": "Link 6" }, { "type": "url", "id": "u6", "label": "URL 6" },
        { "type": "text", "id": "l7", "label": "Link 7" }, { "type": "url", "id": "u7", "label": "URL 7" },
        { "type": "text", "id": "l8", "label": "Link 8" }, { "type": "url", "id": "u8", "label": "URL 8" }
      ]
    }
  ],
  "presets": [{ "name": "NR Popular search" }]
}
{% endschema %}
