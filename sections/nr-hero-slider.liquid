<link rel="stylesheet" href="{{ 'nr-hero.css' | asset_url }}">
<div class="swiper cust-gallery-hero" data-autoplay="{{ section.settings.autoplay | times: 1000 }}">
  <div class="swiper-wrapper">
    {%- for block in section.blocks -%}
      {%- if block.type == 'slide' -%}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          {% render 'nr-media', image: block.settings.image_desktop, fallback: block.settings.fallback_desktop, alt: block.settings.button_label, class: 'desktop' %}
          {% render 'nr-media', image: block.settings.image_mobile, fallback: block.settings.fallback_mobile, alt: block.settings.button_label, class: 'mobile', mobile: true %}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="gallery-banner-link">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div class="swiper-pagination"></div>
</div>

{% schema %}
{
  "name": "NR Hero slider",
  "settings": [
    { "type": "range", "id": "autoplay", "min": 2, "max": 10, "step": 1, "unit": "s", "label": "Autoplay", "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image_desktop", "label": "Desktop image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
        { "type": "text", "id": "fallback_desktop", "label": "Fallback desktop URL" },
        { "type": "text", "id": "fallback_mobile", "label": "Fallback mobile URL" },
        { "type": "text", "id": "button_label", "label": "Button", "default": "Shop All" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "NR Hero slider" }]
}
{% endschema %}
