<link rel="stylesheet" href="{{ 'nr-banner.css' | asset_url }}">
<link rel="stylesheet" href="{{ 'nr-footer.css' | asset_url }}">
<section class="cust-collection-section">
  <div class="cust-collection-container">
    <div class="cust-collection-img">
      {% render 'nr-media', image: section.settings.image_desktop, fallback: section.settings.fallback_desktop, alt: section.settings.button_label, class: 'desktop' %}
      {% render 'nr-media', image: section.settings.image_mobile, fallback: section.settings.fallback_mobile, alt: section.settings.button_label, class: 'mobile', mobile: true %}
    </div>
    <div class="cust-collection-details">
      <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="cust-collection-button">{{ section.settings.button_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NR Collection banner",
  "settings": [
    { "type": "image_picker", "id": "image_desktop", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text", "id": "fallback_desktop", "label": "Fallback desktop URL", "default": "https://www.nishorama.com/cdn/shop/files/SHOP_ALL_CHASHNI.png?v=1790757015" },
    { "type": "text", "id": "fallback_mobile", "label": "Fallback mobile URL", "default": "https://www.nishorama.com/cdn/shop/files/SHOP_ALL_PICTURE_2.png?v=1790757000" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop All" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "NR Collection banner" }]
}
{% endschema %}
