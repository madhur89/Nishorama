<link rel="stylesheet" href="{{ 'nr-fits.css' | asset_url }}">
<section class="home-fits-wrapper">
  <div class="home-fits-main">
    <h1>{{ section.settings.heading }}</h1>
    <div class="fits-tabs">
      {%- assign tab_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <button class="fit-tab{% if tab_i == 0 %} active{% endif %}" type="button" data-index="{{ tab_i }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
          {%- assign tab_i = tab_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
    <div class="fits-products-wrapper">
      {%- assign tab_i = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'tab' -%}
          <div class="fits-products{% if tab_i == 0 %} active{% endif %}" data-index="{{ tab_i }}">
            <div class="fits-products-grid">
              {%- if block.settings.image_1 != blank or block.settings.f1 != blank -%}
                <a href="{{ block.settings.u1 }}">{% render 'nr-media', image: block.settings.image_1, fallback: block.settings.f1, alt: '', class: '' %}</a>
              {%- endif -%}
              {%- if block.settings.image_2 != blank or block.settings.f2 != blank -%}
                <a href="{{ block.settings.u2 }}">{% render 'nr-media', image: block.settings.image_2, fallback: block.settings.f2, alt: '', class: '' %}</a>
              {%- endif -%}
              {%- if block.settings.image_3 != blank or block.settings.f3 != blank -%}
                <a href="{{ block.settings.u3 }}">{% render 'nr-media', image: block.settings.image_3, fallback: block.settings.f3, alt: '', class: '' %}</a>
              {%- endif -%}
              {%- if block.settings.image_4 != blank or block.settings.f4 != blank -%}
                <a href="{{ block.settings.u4 }}">{% render 'nr-media', image: block.settings.image_4, fallback: block.settings.f4, alt: '', class: '' %}</a>
              {%- endif -%}
              {%- if block.settings.image_5 != blank or block.settings.f5 != blank -%}
                <a href="{{ block.settings.u5 }}">{% render 'nr-media', image: block.settings.image_5, fallback: block.settings.f5, alt: '', class: '' %}</a>
              {%- endif -%}
              {%- if block.settings.image_6 != blank or block.settings.f6 != blank -%}
                <a href="{{ block.settings.u6 }}">{% render 'nr-media', image: block.settings.image_6, fallback: block.settings.f6, alt: '', class: '' %}</a>
              {%- endif -%}
              <a class="fits-discover-card" href="{{ block.settings.more_url | default: routes.all_products_collection_url }}">
                <span class="fits-discover-svg">
                  <svg viewBox="0 0 24 24" fill="none" stroke="#482922" stroke-width="1.5"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </span>
                <span class="fits-discover-btn">{{ section.settings.more_label }}</span>
              </a>
            </div>
          </div>
          {%- assign tab_i = tab_i | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "NR Home fits",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Curated Fits for you" },
    { "type": "text", "id": "more_label", "label": "Discover more", "default": "Discover more" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Restocked" },
        { "type": "url", "id": "more_url", "label": "Discover URL" },
        { "type": "image_picker", "id": "image_1", "label": "Image 1" },
        { "type": "text", "id": "f1", "label": "Fallback 1" },
        { "type": "url", "id": "u1", "label": "URL 1" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "text", "id": "f2", "label": "Fallback 2" },
        { "type": "url", "id": "u2", "label": "URL 2" },
        { "type": "image_picker", "id": "image_3", "label": "Image 3" },
        { "type": "text", "id": "f3", "label": "Fallback 3" },
        { "type": "url", "id": "u3", "label": "URL 3" },
        { "type": "image_picker", "id": "image_4", "label": "Image 4" },
        { "type": "text", "id": "f4", "label": "Fallback 4" },
        { "type": "url", "id": "u4", "label": "URL 4" },
        { "type": "image_picker", "id": "image_5", "label": "Image 5" },
        { "type": "text", "id": "f5", "label": "Fallback 5" },
        { "type": "url", "id": "u5", "label": "URL 5" },
        { "type": "image_picker", "id": "image_6", "label": "Image 6" },
        { "type": "text", "id": "f6", "label": "Fallback 6" },
        { "type": "url", "id": "u6", "label": "URL 6" }
      ]
    }
  ],
  "presets": [{ "name": "NR Home fits" }]
}
{% endschema %}
